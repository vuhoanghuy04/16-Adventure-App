<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Bắt buộc tạo bg_sheet_rounded trong drawable hoặc dùng shape trơn. Nhưng MaterialBottomSheet tự bo góc nếu có style -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF5252"
        android:gravity="center"
        android:padding="12dp"
        android:text="Tìm Kiếm Và Lọc"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" /> <!-- Giả lập thanh đỏ theo thiết kế figma -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Thời gian"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerTime"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="#EEEEEE" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Địa Điểm"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#EEEEEE"
        android:orientation="vertical"
        android:padding="8dp">

        <CheckBox
            android:id="@+id/cbDoSon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đồ Sơn" />

        <CheckBox
            android:id="@+id/cbCatBa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cát Bà" />

        <CheckBox
            android:id="@+id/cbKienAn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kiến An" />

        <CheckBox
            android:id="@+id/cbTrungTam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trung tâm thành phố" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplyFilter"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:text="Áp Dụng"
        android:textSize="16sp"
        app:backgroundTint="#FF5252"
        app:cornerRadius="16dp" />

</LinearLayout>
