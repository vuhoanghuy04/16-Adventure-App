<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/quiz_background_liquid"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_glass_panel"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBackQuiz"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="@drawable/btn_glass_option"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/glass_text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bạn hiểu Hải Phòng đến đâu?"
            android:textAlignment="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/glass_text_primary" />

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_glass_option"
            android:gravity="center"
            android:text="0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/liquid_pink" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbCountdown"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:max="1000"
        android:progress="1000"
        android:progressTint="@color/liquid_pink"
        android:visibility="invisible"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="@id/layoutHeader"
        app:layout_constraintStart_toStartOf="@id/layoutHeader"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardQuizImage"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/glass_white_stroke"
        app:cardBackgroundColor="@color/glass_white_fill"
        app:layout_constraintTop_toBottomOf="@id/pbCountdown">

        <ImageView
            android:id="@+id/ivQuizImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#E0E0E0" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="32dp"
        android:text="Đang kết nối..."
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/glass_text_primary"
        android:gravity="start"
        app:layout_constraintTop_toBottomOf="@id/cardQuizImage" />

    <LinearLayout
        android:id="@+id/layoutOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_marginBottom="110dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOption1"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:text="Đáp án 1"
            android:textColor="@color/glass_text_primary"
            android:textAllCaps="false"
            android:textSize="17sp"
            app:backgroundTint="@null"
            android:background="@drawable/btn_glass_option"
            app:cornerRadius="20dp"
            app:elevation="4dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOption2"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:text="Đáp án 2"
            android:textColor="@color/glass_text_primary"
            android:textAllCaps="false"
            android:textSize="17sp"
            app:backgroundTint="@null"
            android:background="@drawable/btn_glass_option"
            app:cornerRadius="20dp"
            app:elevation="4dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOption3"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Đáp án 3"
            android:textColor="@color/glass_text_primary"
            android:textAllCaps="false"
            android:textSize="17sp"
            app:backgroundTint="@null"
            android:background="@drawable/btn_glass_option"
            app:cornerRadius="20dp"
            app:elevation="4dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>