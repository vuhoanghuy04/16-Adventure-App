<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>
    <item>
        <rotate android:fromDegrees="45" android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="rectangle">
                <solid android:color="#C8102E"/>
                <size android:width="20dp" android:height="100dp"/>
            </shape>
        </rotate>
    </item>
    <item>
        <rotate android:fromDegrees="-45" android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="rectangle">
                <solid android:color="#C8102E"/>
                <size android:width="20dp" android:height="100dp"/>
            </shape>
        </rotate>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#012169"/>
            <size android:width="10dp" android:height="100dp"/>
        </shape>
    </item>
    <item>
        <rotate android:fromDegrees="90" android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="rectangle">
                <solid android:color="#012169"/>
                <size android:width="10dp" android:height="100dp"/>
            </shape>
        </rotate>
    </item>
</layer-list>