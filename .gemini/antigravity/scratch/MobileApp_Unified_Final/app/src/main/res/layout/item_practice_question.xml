<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/tv_item_step"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Câu 1"
        android:textColor="#FF5722"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/tv_item_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:text="Question..."
            android:textColor="#1E293B"
            android:textSize="18sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:columnCount="2"
        android:useDefaultMargins="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_item_a" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="56dp" android:layout_columnWeight="1"
            android:layout_marginEnd="8dp" android:textColor="#333333" app:cornerRadius="12dp"
            app:strokeColor="#E2E8F0" app:strokeWidth="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_item_b" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="56dp" android:layout_columnWeight="1"
            android:layout_marginStart="8dp" android:textColor="#333333" app:cornerRadius="12dp"
            app:strokeColor="#E2E8F0" app:strokeWidth="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_item_c" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="56dp" android:layout_columnWeight="1"
            android:layout_marginEnd="8dp" android:textColor="#333333" app:cornerRadius="12dp"
            app:strokeColor="#E2E8F0" app:strokeWidth="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_item_d" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="56dp" android:layout_columnWeight="1"
            android:layout_marginStart="8dp" android:textColor="#333333" app:cornerRadius="12dp"
            app:strokeColor="#E2E8F0" app:strokeWidth="2dp" />
    </GridLayout>
</LinearLayout>